@ Unsupported character: the lexer should report an unrecognized character.
~

@ Missing closing quote: the lexer should report an unterminated string.
SALITA _mensahe = "Hindi naisara ang string

@ Single ampersand and pipe are invalid; the lexer accepts && and ||.
KUNDISYON invalid_and = TAMA & MALI.
KUNDISYON invalid_or = TAMA | MALI.

@ Valid input after the invalid tokens should still be recognized.
NUMERO next_value = 50.

@ Scanning continues after the lexical errors.
SALITA kasunod = "tapos".